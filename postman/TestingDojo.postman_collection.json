                "exec": [
                  "// 1. Test that the status code is 200",
                  "utils.StatusOk();",
                  "",
                  "// 2. Parse the response body as a JSON object",
                  "const jsonData = pm.response.json();",
                  "",
                  "const totalMenus = 3;",
                  "// 3. Verify that returns 3 main menus",
                  "pm.test(\"The menu has exactly \" + totalMenus +  \" main items\", function () {",
                  "   pm.expect(jsonData.length).to.eql(totalMenus);",
                  "});",
                  "",
                  "// 4. Vefify first menu",
                  "let expectedMenu = \"売掛金\"",
                  " pm.test(\"Frist menu is: \" + expectedMenu + \"(Account Receivable)\",  function () {",
                  "        pm.expect(jsonData[0].label).to.eql(expectedMenu);",
                  "        pm.expect(jsonData[0].items).to.be.an('array'); ",
                  "});",
                  "",
                  "expectedMenu = \"セキュリティ\";",
                  "// 5. Vefify second menu",
                  "pm.test(\"Second main item is: \" + expectedMenu + \" (Security)\", function () {",
                  "    pm.expect(jsonData[1].label).to.eql(expectedMenu);",
                  "    pm.expect(jsonData[1].items).to.be.an('array');",
                  "});",
                  "",
                  "expectedMenu = \"設定\";",
                  "// 6. Check the third main item (Settings)",
                  "pm.test(\"Third main item is \" + expectedMenu +  \" (Config)\", function () {",
                  "    pm.expect(jsonData[2].label).to.eql(expectedMenu);",
                  "    pm.expect(jsonData[2].items).to.be.an('array');",
                  "});"
                ],
