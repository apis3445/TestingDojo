          "name": "Admin",
          "item": [
            {
              "name": "Login_withAdminUser_ReturnsAdminToken",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "//Date functions",
                      "const moment = require(\"moment\")",
                      "",
                      "// 1. Test that the status code is 200",
                      "utils.StatusOk();",
                      "",
                      "// 2. Parse the response body as a JSON object",
                      "const jsonData = pm.response.json();",
                      "",
                      "// 3. Test the response body — all 8 fields of LoginResponse",
                      "pm.test(\"AccessToken is a decodable JWT\", function () {",
                      "    const parts = jsonData.AccessToken.split('.');",
                      "    pm.expect(parts.length, 'JWT must have 3 segments').to.equal(3);",
                      "    const decodeSegment = (seg) => {",
                      "        const base64 = seg.replace(/-/g, '+').replace(/_/g, '/');",
                      "        const padded = base64 + '='.repeat((4 - base64.length % 4) % 4);",
                      "        return JSON.parse(atob(padded));",
                      "    };",
                      "    pm.expect(() => decodeSegment(parts[0]), 'header must decode to JSON').to.not.throw();",
                      "    pm.expect(() => decodeSegment(parts[1]), 'payload must decode to JSON').to.not.throw();",
                      "});",
                      "",
                      "pm.test(\"TokenExpiration is in the future and within 24 hours\", function () {",
                      "    const expiry = moment.utc(jsonData.TokenExpiration);",
                      "    const now = moment.utc();",
                      "    pm.expect(expiry.isValid()).to.be.true;",
                      "    pm.expect(expiry.isAfter(now), 'Token expiration should be in the future').to.be.true;",
                      "    pm.expect(expiry.isBefore(now.clone().add(24, 'hours').add(5, 'minutes')), 'Token expiration should be within ~24 hours').to.be.true;",
                      "});",
                      "",
                      "const expectedUserId = parseInt(pm.environment.get(\"userIdAdmin\"));",
                      "pm.test(\"UserId is: \" + expectedUserId, function () {",
                      "    pm.expect(jsonData.UserId).to.eql(expectedUserId);",
                      "});",
                      "",
                      "const expectedName = pm.environment.get(\"nameAdmin\");",
                      "pm.test(\"Name is: \" + expectedName, function () {",
                      "    pm.expect(jsonData.Name).to.eql(expectedName);",
                      "});",
                      "",
                      "const expectedEmail = pm.environment.get(\"emailAdmin\");",
                      "pm.test(\"Email is: \" + expectedEmail, function () {",
                      "    pm.expect(jsonData.Email).to.eql(expectedEmail);",
                      "});",
                      "",
                      "pm.test(\"RefreshToken is a non-empty string\", function () {",
                      "    pm.expect(jsonData.RefreshToken).to.be.a('string').and.to.not.be.empty;",
                      "});",
                      "",
                      "const expectedCompany = pm.environment.get(\"companyAdmin\");",
                      "pm.test(\"Company is: \" + expectedCompany, function () {",
                      "    pm.expect(jsonData.Company).to.eql(expectedCompany);",
                      "});",
                      "",
                      "const expectedCompanyKey = parseInt(pm.environment.get(\"companyKeyAdmin\"));",
                      "pm.test(\"CompanyKey is: \" + expectedCompanyKey, function () {",
                      "    pm.expect(jsonData.CompanyKey).to.eql(expectedCompanyKey);",
                      "});",
                      "",
                      "const expectedLanguage = pm.environment.get(\"language\");",
                      "pm.test(\"Language is: \" + expectedLanguage, function () {",
                      "    pm.expect(jsonData.Language).to.eql(expectedLanguage);",
                      "});",
                      "",
                      "// 4. Response time",
                      "pm.test(\"Response time is less than 3 seconds\", function () {",
                      "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                      "});",
                      "",
                      "// 5. Store the AccessToken in a collection variable for future use",
                      "pm.collectionVariables.set(\"AccessTokenAdmin\", jsonData.AccessToken);",
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
