    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "utils = {",
          "  StatusOk: function() {",
          "    pm.test(\"Status is 200\", function () {",
          "        pm.response.to.be.ok;",
          "    });",
          "  },",
          "  Status401: function () {",
          "    pm.test(\"Status is 401\", function () {",
          "        pm.response.to.have.status(401);",
          "    });",
          "  },",
          "  Status400: function() {",
          "    pm.test(\"Status is 400\", function () {",
          "        pm.response.to.have.status(400);",
          "    });",
          "  },",
          "  ArrayAbove0: function(arrayName) {",
          "    var response = pm.response.json();",
          "    pm.test(\"Array of '\" + arrayName + \"' is greater than 0\", function() ",
          "    {",
          "        pm.expect(response.length).to.be.above(0)",
          "    });",
          "  },",
          "  CheckLength: function(length) {",
          "    var response = pm.response.json();",
          "    pm.test(\"Returns \" + length + \" results\" , function() ",
          "    {",
          "        pm.expect(response.length).to.be.eql(length)",
          "    });",
          "  },",
          "  CheckRequired: function(fieldName) {",
          "    pm.test(\"Error field is \" + fieldName, function () {",
          "        const jsonData = pm.response.json();",
