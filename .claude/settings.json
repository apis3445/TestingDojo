{
  "permissions": {
    "allow": ["mcp__plugin_playwright_playwright", "Bash(playwright-cli*)", "Bash(npx tsc --noEmit*)"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit",
        "hooks": [
          { 
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/read_hook.js\"",
            "statusMessage": "Checking file access..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/bash_env_check.py\"",
            "statusMessage": "Checking command..."
          }
        ]
      }
    ],
    "PostToolUse": []
  }
}