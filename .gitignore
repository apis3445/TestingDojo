
# Playwright
e2e/playwright/node_modules/
e2e/playwright/test-results/
e2e/playwright/playwright-report/
e2e/playwright/blob-report/
e2e/playwright/.cache/
e2e/playwright/.auth/

API/Net/bin/Debug/net10.0/
API/Net/bin/Release/net10.0/
API/Net/obj/Debug/net10.0/
API/Net/obj/Release/net10.0/

APINet/obj/
APINet/bin/Debug/

# Postman — never commit files with real credentials
postman/*secrets*
postman/*local*

# macOS metadata files (created automatically by Finder)
.DS_Store
**/.DS_Store

# .NET — environment-specific settings with real URLs/credentials
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json

.auth/
video.webm
adminLogin.webm

# Env files — ignore every variant (.env, .env.local, .env.production, ...)
# anywhere in the repo, but keep example templates tracked
**/.env*
!**/.env*.example

# Explicit belt-and-braces ignores — kept in addition to the glob above so a
# narrower future edit to that pattern can't silently start tracking secrets
.env
e2e/playwright/.env
e2e/playwright/.snapshots
e2e/playwright/.env.*
!e2e/playwright/.env.example

/node-modules/
/.playwright-mcp/

# Claude Code local state — machine-specific, keyed by absolute project path
.claude/projects/
server.webm