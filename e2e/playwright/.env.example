# Copy this file to .env and fill in the real values.
# .env is excluded from git — never commit credentials to the repository.

# URL of the app under test
BASE_URL=https://abi-testing-dojo-demo.azurewebsites.net/

# URL of the authentication service (used to obtain JWT tokens)
AUTH_URL=https://abi-testing-dojo-auth-demo.azurewebsites.net/

# Company identifier shown on the login screen
COMPANY=YourCompany

# Admin user — has access to all menu items including Security and Config
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=secret

# Normal user — has limited menu access (no Security menu item)
NORMAL_USER=user@example.com
NORMAL_PASSWORD=secret

# Locale for local runs (en-US | es-MX | de-DE | ja-JP)
# On CI this is controlled by the Playwright project name, not this variable.
LOCALE=en-US

# Optional: Azure DevOps integration for snap-ally's accessibility reporter (playwright.config.ts).
# When set, a11y violations found by checkAccessibility() can be filed as ADO bugs directly from the report.
# Leave unset to skip ADO bug creation — accessibility scanning and reporting still work without them.
ADO_ORGANIZATION=your-ado-org
ADO_PROJECT=YourAdoProject
ADO_AREA_PATH=YourAdoProject\YourTeam

